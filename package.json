{
  "name": "game-brainstormer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "ks250206",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp build --ssr src/entry-server.tsx --outDir .ssg && node scripts/prerender.mjs",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test",
    "data:build": "python3 scripts/prepare-data.py",
    "build:portable": "node scripts/build-portable.mjs",
    "screenshot": "playwright test tests/screenshots.spec.ts",
    "astryx:init": "astryx init"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
    "@stylexjs/stylex": "^0.18.3",
    "@xyflow/react": "^12.9.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "vite-plus": "^1.5.0"
  }
}
